# ─── SfX LP API — environment template ─────────────────────────────
# Copy to server/.env for local development. NEVER commit real values.
# Production values live only on the production server / secret store.

APP_ENV=development            # development | staging | production
NODE_ENV=development
PORT=5000

# Use a SEPARATE database per environment (e.g. sfxlp_dev / sfxlp_prod clusters).
MONGO_URI=mongodb://127.0.0.1:27017/sfxlp_dev

# Primary web app origin + optional extra origins (comma separated)
CLIENT_URL=http://localhost:3000
CLIENT_URLS=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# First admin is created on boot if it does not exist. Change password after first login.
ADMIN_NAME=SfX LP Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo LP account (development/staging only — ignored in production)
DEMO_LP_NAME=Demo LP User
DEMO_LP_EMAIL=
DEMO_LP_PASSWORD=

# Firebase (push notifications) — use a NEW SfX project, separate per env if possible
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default trade data source (optional). Use sandbox credentials outside production.
TRADES_API_NAME=Default trade source
TRADES_API_BASE_URL=
TRADES_API_KEY=

# Deploy webhook is disabled unless this is set (send as x-deploy-secret header)
DEPLOY_WEBHOOK_SECRET=

# Private files (KYC, deposit proofs). Keep OUTSIDE any web-served folder; back it up.
PRIVATE_UPLOAD_DIR=private_uploads

# Licence switch (vendor). Google Sheet -> File -> Share -> Publish to web -> CSV link.
# Keep this URL private (server only). Empty = feature off.
LICENSE_SHEET_CSV_URL=
LICENSE_APP_ID=swissliquidity
LICENSE_POLL_MINUTES=5
LICENSE_DEFAULT_LOCKED=true
